[Unit]
Description=Grexa Web App - Admin Panel
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/ubuntu/grexa-webapp-admin
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

# All env vars live in /etc/grexa/deployer.env on the server (not in git)
EnvironmentFile=/etc/grexa/deployer.env

[Install]
WantedBy=multi-user.target